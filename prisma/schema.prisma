datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model AdminUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id           String     @id @default(cuid())
  name         String
  slug         String     @unique
  division     String     @default("fast-food") // "tiffins" | "biryanis" | "fast-food" | "pickles"
  image        String?
  description  String?
  icon         String?
  displayOrder Int        @default(0)
  isActive     Boolean    @default(true)
  items        FoodItem[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model SubsiteConfig {
  id              String   @id // "tiffins" | "biryanis" | "fast-food" | "pickles"
  title           String
  shortTitle      String
  tagline         String
  quote           String
  description     String
  heroImage       String
  theme           String
  scheduleLabel   String
  timeWindowsJson String   // JSON array of [{ start: "06:00", end: "10:30" }, ...]
  alwaysOpen      Boolean  @default(false)
  isOpenOverride  Boolean? // null = follow schedule, true = force open, false = force closed
  isActive        Boolean  @default(true)
  pausedMessage   String?
  displayOrder    Int      @default(0)
  updatedAt       DateTime @updatedAt
}

model FoodItem {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String
  price        Float
  image        String
  categoryId   String
  category     Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  isVeg        Boolean  @default(true)
  isSpicy      Boolean  @default(false)
  isBestseller Boolean  @default(false)
  isSignature  Boolean  @default(false)
  isAvailable  Boolean  @default(true)
  prepTime     String   @default("10-15 mins")
  portionSize  String?
  ingredients  String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model GalleryImage {
  id           String   @id @default(cuid())
  title        String
  category     String   @default("Dishes") // "Dishes", "Ambiance", "Kitchen", "Heritage"
  imageUrl     String
  caption      String?
  isAmbiance   Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
}

model RestaurantSetting {
  id                String   @id @default("default")
  restaurantName    String   @default("UPAHAR TIFFINS AND FAST FOOD")
  tagline           String   @default("Authentic Flavours. Freshly Served with Warmth.")
  heroHeadline      String   @default("The Soul of South Indian Tiffins & Street Classics")
  heroSubheadline   String   @default("From sunrise to sunset, crafted with stone-ground batter, pure desi ghee, and time-honored recipes.")
  storyTitle        String   @default("Born From A Deep Love for Honest South Indian Cooking")
  storyText         String   @default("At UPAHAR, every morning begins with the slow rhythm of traditional granite wet grinders and the intoxicating fragrance of tempered mustard seeds. We prepare every single batch of idli batter, spicy karam, and slow-simmered drumstick sambar fresh daily with zero shortcuts.")
  phone             String   @default("+91 98765 43210")
  email             String   @default("namaste@upahartiffins.com")
  whatsappNumber    String   @default("919876543210")
  address           String   @default("1-1, Sangivalasa, ANITS College Road, beside SBI")
  landmark          String   @default("Beside SBI, ANITS College Road")
  googleMapsUrl     String   @default("https://maps.app.goo.gl/6611R6FD1JZagSJt9")
  openingTime       String   @default("06:00")
  closingTime       String   @default("22:30")
  breakfastHours    String   @default("6:30 AM – 11:30 AM")
  lunchHours        String   @default("11:30 AM – 4:00 PM")
  eveningHours      String   @default("4:00 PM – 8:00 PM")
  dinnerHours       String   @default("8:00 PM – 11:00 PM")
  isEmergencyClosed Boolean  @default(false)
  isEmergencyWebsiteStopped Boolean @default(false)
  emergencyStopMessage    String   @default("Upahar online ordering is temporarily paused by administration. We will be back shortly!")
  isOnlineOrderingEnabled Boolean  @default(true)
  enforceStoreHours       Boolean  @default(true)
  deliveryRadiusKm        Float    @default(5.0)
  deliveryBaseFee         Float    @default(25.0)
  minOrderFreeDelivery    Float    @default(199.0)
  minDeliveryOrderAmount  Float    @default(60.0)
  packagingFee            Float    @default(10.0)
  upiId                   String   @default("paytm.s2fno8y@pty")
  upiMerchantName         String   @default("Suravajjula Sai Sri Vamsi")
  paymentQrUrl            String   @default("/images/payment-qr.jpg")
  fssaiNumber             String?
  instagramUrl            String   @default("https://instagram.com/upahartiffins")
  pureVegPledge           String   @default("100% Pure Vegetarian Kitchen • Pure Desi Ghee • RO Purified Water")
  updatedAt               DateTime @updatedAt
}

model CustomerUser {
  id           String            @id @default(cuid())
  name         String
  phone        String            @unique
  email        String?
  passwordHash String
  address      String?
  landmark     String?
  locality     String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  orders       Order[]
  addresses    CustomerAddress[]
}

model CustomerAddress {
  id         String       @id @default(cuid())
  customerId String
  customer   CustomerUser @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String       @default("Home") // "Home" | "ANITS Hostel" | "Work" | "Other"
  address    String
  landmark   String?
  locality   String       @default("ANITS Campus & Hostels")
  lat        Float?
  lng        Float?
  distanceKm Float?
  isDefault  Boolean      @default(false)
  createdAt  DateTime     @default(now())
}

model CustomerOtp {
  id        String   @id @default(cuid())
  phone     String
  code      String
  purpose   String   @default("LOGIN") // "LOGIN" | "SIGNUP"
  verified  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Coupon {
  id             String   @id @default(cuid())
  code           String   @unique
  description    String
  discountType   String   @default("FLAT") // "FLAT" | "PERCENT"
  discountValue  Float
  minOrderAmount Float    @default(0)
  maxDiscount    Float?
  isActive       Boolean  @default(true)
  usageCount     Int      @default(0)
  createdAt      DateTime @default(now())
}

model DeliveryAgent {
  id              String    @id @default(cuid())
  name            String
  phone           String    @unique
  vehicleNumber   String
  passwordHash    String    // PIN or password for delivery boy login
  status          String    @default("ACTIVE") // "ACTIVE" | "ON_DELIVERY" | "OFFLINE" | "INACTIVE"
  approvalStatus  String    @default("APPROVED") // "PENDING_APPROVAL" | "APPROVED" | "REJECTED"
  isActive        Boolean   @default(true)
  totalDeliveries Int       @default(0)
  cashInHand      Float     @default(0)
  totalEarnings   Float     @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  orders          Order[]
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  contact   String
  email     String?
  subject   String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Order {
  id                      String         @id @default(cuid())
  orderNumber             String         @unique
  customerId              String?
  customer                CustomerUser?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName            String
  customerPhone           String
  orderType               String         @default("DELIVERY") // "DELIVERY" | "TAKEAWAY" | "DINE_IN"
  tableNumber             String?
  deliveryAddress         String?
  landmark                String?
  locality                String?
  lat                     Float?
  lng                     Float?
  distanceKm              Float?
  deliveryFee             Float          @default(0)
  packagingFee            Float          @default(0)
  couponCode              String?
  discountAmount          Float          @default(0)
  subtotal                Float
  totalAmount             Float
  specialInstructions     String?
  paymentMethod           String         @default("COD") // "COD" | "UPI" | "QR_ON_DELIVERY"
  paymentStatus           String         @default("PENDING") // "PENDING" | "VERIFICATION_PENDING" | "PAID"
  upiTransactionId        String?
  paymentConfirmedBy      String?
  status                  String         @default("PENDING") // "PENDING" | "CONFIRMED" | "PREPARING" | "FOOD_READY" | "OUT_FOR_DELIVERY" | "ARRIVED" | "DELIVERED" | "CANCELLED"
  deliveryOtp             String         @default("1234") // 4-digit code shown to customer and verified by delivery boy
  deliveryAgentId         String?
  deliveryAgent           DeliveryAgent? @relation(fields: [deliveryAgentId], references: [id], onDelete: SetNull)
  riderLat                Float?
  riderLng                Float?
  riderLocationUpdatedAt  DateTime?
  estimatedTime           String?        @default("20-25 mins")
  rejectionReason         String?
  cancelledBy             String?
  cancelledAt             DateTime?
  rating                  Int?
  deliveryRating          Int?
  reviewComment           String?
  reviewedAt              DateTime?
  paymentCollectedAt      DateTime?
  deliveredAt             DateTime?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  items                   OrderItem[]
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  foodItemId  String?
  name        String
  price       Float
  quantity    Int
  portionSize String?
  createdAt   DateTime @default(now())
}
